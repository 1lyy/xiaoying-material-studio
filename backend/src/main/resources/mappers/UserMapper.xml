<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoying.materialstudio.identity.UserMapper">
    <resultMap id="userRow" type="com.xiaoying.materialstudio.identity.UserRow">
        <constructor>
            <idArg column="id" javaType="java.lang.String"/>
            <arg column="demo_key" javaType="java.lang.String"/>
            <arg column="display_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="userColumns">id, demo_key, display_name</sql>

    <select id="findAll" resultMap="userRow">
        SELECT <include refid="userColumns"/> FROM users ORDER BY demo_key
    </select>

    <select id="findByDemoKey" resultMap="userRow">
        SELECT <include refid="userColumns"/> FROM users WHERE demo_key = #{demoKey}
    </select>

    <select id="findById" resultMap="userRow">
        SELECT <include refid="userColumns"/> FROM users WHERE id = #{id}
    </select>
</mapper>

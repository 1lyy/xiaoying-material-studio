# Local demonstration values only. Copy to .env before docker compose up --build.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
MYSQL_DATABASE=material_studio
MYSQL_USER=material_app
MYSQL_PASSWORD=local_demo_password
MYSQL_ROOT_PASSWORD=local_demo_root_password
DEMO_MODE=true
TASK_WORKER_ENABLED=true
DEFAULT_STAGE_DELAY_MS=2000
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
STORAGE_ROOT=/data/assets
JAVA_API_ORIGIN=http://backend:8080
